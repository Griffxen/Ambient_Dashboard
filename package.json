{
  "name": "ambient-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "ambient-dashboard",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "build": "tsc --noEmit && vite build",
    "package:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "package:windows": "npm run build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.example.ambientdashboard",
    "productName": "Ambient Dashboard",
    "asar": true,
    "asarUnpack": ["electron/**/*.py", "electron/**/*.ps1"],
    "files": ["dist/**/*", "electron/**/*", "package.json", "node_modules/qrcode/**/*"],
    "directories": { "output": "release" },
    "linux": { "target": "AppImage", "category": "Utility", "icon": "build/icons", "syncDesktopName": true },
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^38.1.2",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
